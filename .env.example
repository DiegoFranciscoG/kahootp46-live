# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# docker compose se niega a arrancar si falta alguna variable obligatoria.

# PostgreSQL
DB_NAME=kahootp46
DB_USER=kahootp46
DB_PASSWORD=CAMBIAR

# Redis (solo letras y números: va dentro de la URL redis://)
REDIS_PASSWORD=CAMBIAR

# JWT HS256: mínimo 32 bytes aleatorios. Ejemplo: openssl rand -base64 48
JWT_SECRET=

# Cuenta admin creada al primer arranque (no existe registro público). Contraseña de 12 a 72 caracteres.
ADMIN_EMAIL=admin@kahootp46.local
ADMIN_PASSWORD=

# Orígenes del navegador permitidos para la API y el WebSocket, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# demo = carga quizzes de ejemplo ficticios al primer arranque
SPRING_PROFILES_ACTIVE=demo

# Puertos en el host (solo 127.0.0.1). Si cambias FRONTEND_PORT, ajusta CORS_ALLOWED_ORIGINS.
FRONTEND_PORT=4200
BACKEND_PORT=8081
